{ Ambitos: las variables del cuerpo principal son globales;
  las de funciones y bloques son locales y pueden ocultar a las globales }
int x, contador;

procedure incrementar()
    contador := contador + 1      { usa la variable global }
end;

function int prueba(int x)        { el parametro x oculta a la global x }
    int y;
    y := x * 10;
    if y > 50 then
        int x;                    { x local al bloque then }
        x := 1;
        y := y + x
    end;
    return y + x                  { aqui x vuelve a ser el parametro }
end;

x := 7;
contador := 0;
incrementar();
incrementar();
write prueba(3);    { 30 + 3 = 33 }
write prueba(6);    { 61 + 6 = 67 }
write x;            { la global no cambio: 7 }
write contador;     { 2 }
if x > 0 then
    int temporal;   { solo existe dentro del then }
    temporal := x * 2;
    write temporal
end
